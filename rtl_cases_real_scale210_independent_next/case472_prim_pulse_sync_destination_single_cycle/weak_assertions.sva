// single_cycle_implication
assert property (@(posedge clk_dst_i) disable iff (!rst_dst_ni) (src_pulse_i |-> 1'b1));
// final_output_only
assert property (@(posedge clk_dst_i) disable iff (!rst_dst_ni) (1'b1 |-> !$isunknown(q_o)));
// delay_removed
assert property (@(posedge clk_dst_i) disable iff (!rst_dst_ni) (dst_pulse_o |-> (q_o==q_o)));
// antecedent_removed
assert property (@(posedge clk_dst_i) disable iff (!rst_dst_ni) (q_o==q_o));
// simple_invariant
assert property (@(posedge clk_dst_i) disable iff (!rst_dst_ni) (q_o>=0));
