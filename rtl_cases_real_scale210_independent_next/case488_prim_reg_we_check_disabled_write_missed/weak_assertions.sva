// single_cycle_implication
assert property (@(posedge clk_i) disable iff (!rst_ni) (en_i && $onehot(oh_i)) |-> !err_o);
// final_output_only
assert property (@(posedge clk_i) disable iff (!rst_ni) en_i |-> !$isunknown(err_o));
// delay_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (en_i && (oh_i == 4'b0000)) |-> !err_o);
// antecedent_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (!err_o || err_o));
// simple_invariant
assert property (@(posedge clk_i) disable iff (!rst_ni) !$isunknown(err_o));
