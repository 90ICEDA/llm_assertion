assert property (@(posedge clk_i) disable iff (!rst_ni) (s_valid_i |-> (s_valid_i == s_valid_i)));
assert property (@(posedge clk_i) disable iff (!rst_ni) (1'b1 |-> !$isunknown(q_o)));
assert property (@(posedge clk_i) disable iff (!rst_ni) (ready_i |-> (q_o == q_o)));
assert property (@(posedge clk_i) disable iff (!rst_ni) (q_o == q_o));
assert property (@(posedge clk_i) disable iff (!rst_ni) (state_o <= 8'hff));
