// single_cycle_implication
assert property (@(posedge clk_i) disable iff (!rst_ni) (!drop_i && valid_i |-> valid_o));
// final_output_only
assert property (@(posedge clk_i) disable iff (!rst_ni) (drop_i |-> !valid_o));
// delay_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (ready_i |-> ready_o));
// antecedent_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (!valid_o || valid_i));
// simple_invariant
assert property (@(posedge clk_i) disable iff (!rst_ni) (valid_o |-> valid_i));
