// single_cycle_implication
assert property (@(posedge clk_i) disable iff (!rst_ni) (valid_i && ready_o |=> valid_o));
// final_output_only
assert property (@(posedge clk_i) disable iff (!rst_ni) (valid_o |-> !$isunknown(data_o)));
// delay_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (valid_i |-> ready_o || !ready_o));
// antecedent_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (valid_o || !valid_o));
// simple_invariant
assert property (@(posedge clk_i) disable iff (!rst_ni) (ready_o == (ready_i || !valid_o)));
