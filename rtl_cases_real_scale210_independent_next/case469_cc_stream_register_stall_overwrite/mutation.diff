+`timescale 1ns/1ps
+module cc_stream_register #(parameter Width=8)(
+  input clk_i,rst_ni,clr_i,input valid_i,output ready_o,
+  input [Width-1:0] data_i,output reg valid_o,input ready_i,
+  output reg [Width-1:0] data_o
+);
+  // MUTATION: a stalled output can be overwritten by an unaccepted input.
+  wire ena=valid_i;
+  assign ready_o=ready_i||!valid_o;
+  always @(posedge clk_i or negedge rst_ni) begin
+    if(!rst_ni) begin valid_o<=0;data_o<=0;end
+    else if(clr_i) valid_o<=0;
+    else begin
+      if(ready_o) valid_o<=valid_i;
+      if(ena) data_o<=data_i;
+    end
+  end
+endmodule
