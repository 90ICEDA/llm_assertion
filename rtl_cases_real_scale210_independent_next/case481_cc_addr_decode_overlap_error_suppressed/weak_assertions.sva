// single_cycle_implication
assert property (@(posedge clk_i) disable iff (!rst_ni) (en_i && addr_i<8'h20 |-> !valid_o));
// final_output_only
assert property (@(posedge clk_i) disable iff (!rst_ni) (valid_o |-> $onehot(sel_o)));
// delay_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (en_i |-> !$isunknown(sel_o)));
// antecedent_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (!valid_o || $onehot(sel_o)));
// simple_invariant
assert property (@(posedge clk_i) disable iff (!rst_ni) (error_o |-> !valid_o));
