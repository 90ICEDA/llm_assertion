// single_cycle_implication
assert property (@(posedge clk_src_i) disable iff (!rst_src_ni) (src_req_i |-> 1'b1));
// final_output_only
assert property (@(posedge clk_src_i) disable iff (!rst_src_ni) (1'b1 |-> !$isunknown(q_o)));
// delay_removed
assert property (@(posedge clk_src_i) disable iff (!rst_src_ni) (dst_ack_i |-> (q_o==q_o)));
// antecedent_removed
assert property (@(posedge clk_src_i) disable iff (!rst_src_ni) (q_o==q_o));
// simple_invariant
assert property (@(posedge clk_src_i) disable iff (!rst_src_ni) (q_o>=0));
