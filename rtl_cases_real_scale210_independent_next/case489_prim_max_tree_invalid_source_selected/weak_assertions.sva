// single_cycle_implication
assert property (@(posedge clk_i) disable iff (!rst_ni) (|valid_i) |-> max_valid_o);
// final_output_only
assert property (@(posedge clk_i) disable iff (!rst_ni) max_valid_o |-> !$isunknown(max_value_o));
// delay_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (|valid_i) |-> !$isunknown(max_idx_o));
// antecedent_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (!max_valid_o || !$isunknown(max_value_o)));
// simple_invariant
assert property (@(posedge clk_i) disable iff (!rst_ni) (max_valid_o == (|valid_i)));
