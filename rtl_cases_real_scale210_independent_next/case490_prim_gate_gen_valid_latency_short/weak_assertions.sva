// single_cycle_implication
assert property (@(posedge clk_i) disable iff (!rst_ni) valid_o |-> !$isunknown(data_o));
// final_output_only
assert property (@(posedge clk_i) disable iff (!rst_ni) valid_o |-> (data_o == data_o));
// delay_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) valid_i |-> ##[1:4] valid_o);
// antecedent_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (!valid_o || !$isunknown(data_o)));
// simple_invariant
assert property (@(posedge clk_i) disable iff (!rst_ni) !$isunknown(valid_o));
