// single_cycle_implication
assert property (@(posedge clk_i) disable iff (!rst_ni) ((|req_i) && ready_i) |-> $onehot(gnt_o));
// final_output_only
assert property (@(posedge clk_i) disable iff (!rst_ni) valid_o |-> !$isunknown(idx_o));
// delay_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (valid_o && ready_i) |-> (gnt_o != 4'b0000));
// antecedent_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) (!valid_o || !$isunknown(data_o)));
// simple_invariant
assert property (@(posedge clk_i) disable iff (!rst_ni) $onehot0(gnt_o));
