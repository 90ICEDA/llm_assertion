// W1_single_cycle_implication
assert property (@(posedge clk_i) disable iff (!rst_ni) rst_ni |-> !$isunknown(cnt_o));
// W2_final_output_only
assert property (@(posedge clk_i) disable iff (!rst_ni) rst_ni |-> !$isunknown(cnt_o));
// W3_delay_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) incr_en_i && decr_en_i |-> $stable(cnt_o));
// W4_antecedent_removed
assert property (@(posedge clk_i) disable iff (!rst_ni) !$isunknown(cnt_o));
// W5_simple_invariant
assert property (@(posedge clk_i) disable iff (!rst_ni) rst_ni |-> 1'b1);
