[
  {
    "label": "nonfinal_full_keep",
    "antecedent": "m_axis_tvalid && m_axis_tready && !m_axis_tlast",
    "consequent": "m_axis_tkeep == {M_KEEP_WIDTH{1'b1}}",
    "timing": "same_sample",
    "obligations": [
      "nonfinal_keep"
    ]
  },
  {
    "label": "final_nonempty_keep",
    "antecedent": "m_axis_tvalid && m_axis_tready && m_axis_tlast",
    "consequent": "m_axis_tkeep != {M_KEEP_WIDTH{1'b0}}",
    "timing": "same_sample",
    "obligations": [
      "final_nonempty"
    ]
  },
  {
    "label": "hold_valid",
    "antecedent": "m_axis_tvalid && !m_axis_tready && !rst",
    "consequent": "m_axis_tvalid",
    "timing": "next_sample",
    "obligations": [
      "stall_valid"
    ]
  },
  {
    "label": "hold_payload",
    "antecedent": "m_axis_tvalid && !m_axis_tready && !rst",
    "consequent": "$stable({m_axis_tdata, m_axis_tkeep, m_axis_tlast})",
    "timing": "next_sample",
    "obligations": [
      "stall_payload"
    ]
  },
  {
    "label": "hold_keep_through_stall",
    "antecedent": "m_axis_tvalid && !m_axis_tready && !rst",
    "consequent": "$stable(m_axis_tkeep)",
    "timing": "next_sample",
    "obligations": [
      "stall_payload"
    ]
  }
]
