{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "ReplayResult"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assertion_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "case_id",
    "snapshot_hash",
    "assertion_set_hash",
    "backend",
    "status",
    "evaluations",
    "summary",
    "runs"
  ],
  "additionalProperties": false
}
