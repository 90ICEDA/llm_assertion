{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "Obligation"
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "response": {
      "type": "string",
      "minLength": 1
    },
    "capture": {
      "type": "string",
      "minLength": 1
    },
    "clock": {
      "type": "object",
      "properties": {
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "const": "posedge_pre_NBA"
        },
        "input_drive": {
          "const": "negedge"
        }
      },
      "required": [
        "signal",
        "event",
        "input_drive"
      ],
      "additionalProperties": false
    },
    "latency": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "reset": {
      "type": "object",
      "properties": {
        "signal": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "const": 0
        },
        "cancel_pending": {
          "const": true
        },
        "initial_samples": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "signal",
        "active",
        "cancel_pending",
        "initial_samples"
      ],
      "additionalProperties": false
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signals": {
      "type": "object"
    },
    "input_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "location",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "location",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "confirmation": {
      "enum": [
        "imported_confirmed",
        "human_confirmed",
        "unconfirmed"
      ]
    },
    "initialization": {
      "type": "string",
      "minLength": 1
    },
    "judge": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "reference",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "obligation_id",
    "description",
    "scope",
    "parameters",
    "branches",
    "trigger",
    "response",
    "capture",
    "clock",
    "latency",
    "reset",
    "exceptions",
    "signals",
    "input_constraints",
    "sources",
    "confirmation",
    "initialization",
    "judge"
  ],
  "additionalProperties": false
}
