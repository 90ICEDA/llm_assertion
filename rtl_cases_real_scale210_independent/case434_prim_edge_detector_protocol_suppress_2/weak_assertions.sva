// Task-4 weak candidates; NOT semantic-validation results.
// Every property must be checked on correct/buggy primary and held-out traces.

// W1_single_cycle_implication
// antecedent_nonempty: true
// expected weakness: Checks only the low polarity and omits edge behavior.
W1_single_cycle_implication: assert property (@(posedge clk_i) disable iff (!rst_ni) !d_i |-> !q_sync_o);

// W2_final_output_only
// antecedent_nonempty: true
// expected weakness: Only checks that the endpoint is known.
W2_final_output_only: assert property (@(posedge clk_i) disable iff (!rst_ni) rst_ni |-> !$isunknown(q_sync_o));

// W3_delay_removed
// antecedent_nonempty: true
// expected weakness: Uses next-cycle response for a same-cycle bypass path.
W3_delay_removed: assert property (@(posedge clk_i) disable iff (!rst_ni) d_i |=> q_sync_o);

// W4_antecedent_removed
// antecedent_nonempty: false
// expected weakness: Drops the input relation and becomes a constant-level claim.
W4_antecedent_removed: assert property (@(posedge clk_i) disable iff (!rst_ni) !q_sync_o);

// W5_simple_invariant
// antecedent_nonempty: false
// expected weakness: Does not constrain q_sync_o tracking or pulse timing.
W5_simple_invariant: assert property (@(posedge clk_i) disable iff (!rst_ni) !(q_posedge_pulse_o && q_negedge_pulse_o));
