// Deliberately weak admission candidates for case446_priority_encoder_protocol_suppress_2.
// PENDING VALIDATION: presence in this file is not evidence that a candidate misses the bug.

// weak_single_cycle_implication: Checks only the current sample after a reduced trigger and cannot enforce the required cross-cycle history.
assert property (@(input_unencoded) (output_valid) |-> (input_unencoded[output_encoded]));

// weak_final_output_only: Observes only that the final output is known when already asserted; it ignores how and when that output was reached.
assert property (@(input_unencoded) (input_unencoded[output_encoded]) |-> !$isunknown(input_unencoded[output_encoded]));

// weak_delay_removed: Removes the next-cycle or multi-cycle delay from the intended temporal relationship.
assert property (@(input_unencoded) (output_valid) |-> (input_unencoded[output_encoded]));

// weak_antecedent_removed: Drops the behavioral trigger and reduces the check to output definedness.
assert property (@(input_unencoded) 1'b1 |-> !$isunknown(input_unencoded[output_encoded]));

// weak_simple_invariant: A generic signal-integrity invariant contains no ordering, exact delay, duration, or protocol condition.
assert property (@(input_unencoded) 1'b1 |-> !$isunknown(output_valid));
